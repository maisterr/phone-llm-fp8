# Copy to .env and fill in. Needed by modal_bench.py; the deploy scripts
# themselves need only a logged-in `modal` CLI.

# Your deployed FP8 endpoint (printed by `modal deploy modal_l40s_fp8.py`).
MODAL_LLM_BASE_URL=https://<workspace>--ep-phonellm-alpha-1-l40s-fp8-server-serve.modal.run
MODAL_LLM_MODEL=pipecat-ai/phonellm-alpha-1

# Modal proxy-auth token (modal.com -> Settings -> Proxy Auth Tokens),
# combined form: wk-<id>.ws-<secret>
MODAL_LLM_API_KEY=wk-XXXXXXXX.ws-XXXXXXXX
